{
  "name": "david-runner",
  "private": true,
  "version": "1.0.0",
  "description": "DAVID RUNNER — Corra pela História. Endless runner 3D mobile com identidade bíblica.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "android:sync": "vite build && cap sync android",
    "android:apk": "vite build && cap sync android && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android",
    "ios:sync": "vite build && cap sync ios",
    "ios:open": "cap open ios",
    "icons:native": "python3 scripts/gerar-icones-nativos.py"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
